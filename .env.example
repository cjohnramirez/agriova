# Copy to .env.local and fill in. Both values are safe in the app bundle:
# the publishable key only allows what row level security permits.
# Supabase dashboard > Project Settings > API Keys (and Data API for the URL).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
