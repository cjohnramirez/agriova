#!/bin/sh
# Blocks a push that would put broken code on a shared branch. Runs the same
# checks as CI, minus the slow bundle export.
# Bypass with: git push --no-verify
echo "pre-push: running typecheck, lint, format check and tests..."
if ! npm run --silent verify; then
  echo ""
  echo "pre-push: checks failed. Push blocked."
  echo "Fix the errors, or bypass with 'git push --no-verify' if this is urgent."
  exit 1
fi
echo "pre-push: clean."
exit 0
